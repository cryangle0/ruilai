[Unit]
Description=Ruilai dealer system API
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/work/ruilai/backend
EnvironmentFile=/home/ubuntu/work/ruilai/backend/.env
Environment=RUILAI_PROFILE=prod
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ExecStart=/usr/bin/java -Duser.timezone=Asia/Shanghai -Xms256m -Xmx768m -jar /home/ubuntu/work/ruilai/backend/ruilai-server.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
